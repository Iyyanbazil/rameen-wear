{%- doc -%}
  Shared product recommendations styles used by the section and block.

  @example
  {% render 'product-recommendations-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-recommendations {
    display: block;
  }

  .product-recommendations .buy-buttons-block .quantity-selector,
  .product-recommendations .buy-buttons-block .accelerated-checkout-block {
    display: none;
  }

  .product-recommendations .buy-buttons-block,
  .product-recommendations .buy-buttons-block product-form-component,
  .product-recommendations .buy-buttons-block .product-form-buttons {
    display: block;
    width: 100%;
    margin-inline: 0;
  }

  .product-recommendations .buy-buttons-block .add-to-cart-button {
    height: 38px;
    min-height: 38px;
    padding-block: var(--padding-xs);
  }

  .product-recommendations__skeleton-item {
    aspect-ratio: 3 / 4;
    background-color: var(--color-foreground);
    opacity: var(--skeleton-opacity);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__skeleton-item:nth-child(2n + 1) {
      display: none;
    }
  }

  product-recommendations:has([data-has-recommendations='false']) {
    display: none;
  }
{% endstylesheet %}

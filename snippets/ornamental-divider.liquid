{%- doc -%}
  Renders a decorative floral divider.

  @param {string} color - Complete color value used for the ornament
  @param {string} [class] - Additional class for placement-specific spacing

  @example
  {% render 'ornamental-divider', color: settings.color_palette.color1, class: 'collection-divider' %}
{%- enddoc -%}

<div
  class="ornamental-divider{% if class != blank %} {{ class }}{% endif %}"
  style="--ornamental-divider-color: {{ color }};"
  aria-hidden="true"
>
  <span class="ornamental-divider__line"></span>
  <svg class="ornamental-divider__flower" viewBox="0 0 32 32">
    <g fill="none" stroke="currentColor" stroke-width="1.4">
      <ellipse cx="16" cy="8.5" rx="3" ry="6"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(45 16 16)"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(90 16 16)"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(135 16 16)"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(180 16 16)"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(225 16 16)"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(270 16 16)"></ellipse>
      <ellipse cx="16" cy="8.5" rx="3" ry="6" transform="rotate(315 16 16)"></ellipse>
      <circle cx="16" cy="16" r="2.2"></circle>
    </g>
  </svg>
  <span class="ornamental-divider__line"></span>
</div>

{% stylesheet %}
  .ornamental-divider {
    display: flex;
    gap: var(--padding-xs);
    align-items: center;
    justify-content: center;
    color: var(--ornamental-divider-color);
  }

  .ornamental-divider__line {
    position: relative;
    width: clamp(52px, 8vw, 96px);
    height: 1px;
    background: currentColor;
  }

  .ornamental-divider__line::before,
  .ornamental-divider__line::after {
    position: absolute;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    content: '';
    transform: translateY(-50%);
  }

  .ornamental-divider__line::before {
    inset-inline-start: 0;
  }

  .ornamental-divider__line::after {
    inset-inline-end: 0;
  }

  .ornamental-divider__flower {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
  }
{% endstylesheet %}

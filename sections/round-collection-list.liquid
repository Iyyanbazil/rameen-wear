{% comment %}
  Circular collection navigation for collection pages.
  Uses the merchant-selected list when provided, otherwise falls back to all collections.
  @example
  <!-- Place directly after the collection banner in a collection template. -->
{% endcomment %}

{% liquid
  assign section_collections = section.settings.collection_list

  if section_collections == blank
    assign section_collections = collections
  endif

  assign image_sizes = section.settings.image_size | append: 'px'
%}

<div
  class="section section--page-width round-collection-list"
  style="
    --round-collection-size-setting: {{ section.settings.image_size }}px;
    --round-collection-gap: {{ section.settings.gap }}px;
    --round-collection-padding-top: {{ section.settings.padding_block_start }}px;
    --round-collection-padding-bottom: {{ section.settings.padding_block_end }}px;
  "
>
  <nav class="round-collection-list__nav" aria-label="{{ 'accessibility.link_to_collections' | t }}">
    {% if section.settings.heading != blank %}
      <div class="round-collection-list__heading">
        {{ section.settings.heading }}
        {% render 'ornamental-divider',
          color: section.settings.divider_color,
          class: 'round-collection-list__heading-ornament'
        %}
      </div>
    {% endif %}

    <ul class="round-collection-list__items" role="list">
      {% for collection_item in section_collections limit: section.settings.max_collections %}
        {% liquid
          assign item_image = collection_item.image
          if item_image == blank
            assign item_image = collection_item.products.first.featured_image
          endif

          assign image_loading = 'lazy'
          if section.index <= 2 and forloop.index <= 6
            assign image_loading = 'eager'
          endif
        %}
        <li class="round-collection-list__item">
          <a
            class="round-collection-list__link"
            href="{{ collection_item.url }}"
            {% if collection_item.id == collection.id %}
              aria-current="page"
            {% endif %}
          >
            <span class="round-collection-list__image-wrapper">
              {% if item_image != blank %}
                {{
                  item_image
                  | image_url: width: 480
                  | image_tag:
                    widths: '120, 180, 240, 320, 480',
                    sizes: image_sizes,
                    loading: image_loading,
                    class: 'round-collection-list__image',
                    alt: ''
                }}
              {% else %}
                {% assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 %}
                {% assign placeholder_name = 'collection-apparel-' | append: placeholder_index %}
                {{ placeholder_name | placeholder_svg_tag: 'round-collection-list__image round-collection-list__placeholder' }}
              {% endif %}
            </span>
            <span class="round-collection-list__title">{{ collection_item.title | escape }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  <div class="round-collection-list__current-heading">
    <h3 class="round-collection-list__current-title">{{ collection.title | escape }}</h3>
    {% render 'ornamental-divider', color: section.settings.divider_color, class: 'round-collection-list__ornament' %}
  </div>
</div>

{% stylesheet %}
  .round-collection-list {
    --round-collection-size: var(--round-collection-size-setting);
  }

  .round-collection-list__nav {
    min-width: 0;
    padding-block: var(--round-collection-padding-top) var(--round-collection-padding-bottom);
  }

  .round-collection-list__heading {
    margin-block-start: var(--padding-xl);
    margin-block-end: var(--padding-lg);
    padding-block: var(--padding-sm);
    text-align: center;
  }

  .round-collection-list__heading > * {
    margin: 0;
  }

  .round-collection-list__heading .round-collection-list__heading-ornament {
    margin-block-start: var(--padding-sm);
  }

  .round-collection-list__items {
    display: flex;
    gap: var(--round-collection-gap);
    align-items: flex-start;
    justify-content: safe center;
    margin: 0;
    padding: var(--padding-xs) 0 var(--padding-lg);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline proximity;
    scrollbar-width: thin;
  }

  .round-collection-list__item {
    flex: 0 0 var(--round-collection-size);
    min-width: 0;
    list-style: none;
    scroll-snap-align: start;
  }

  .round-collection-list__link {
    display: grid;
    gap: var(--padding-xs);
    color: var(--color-foreground);
    text-align: center;
    text-decoration: none;
  }

  .round-collection-list__image-wrapper {
    display: block;
    width: var(--round-collection-size);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 50%;
    background: var(--color-background);
    box-shadow:
      0 10px 24px rgb(var(--color-foreground-rgb) / var(--opacity-15)),
      0 3px 8px rgb(var(--color-foreground-rgb) / var(--opacity-10));
    transition: transform var(--animation-speed) var(--animation-easing), box-shadow var(--animation-speed) var(--animation-easing);
  }

  .round-collection-list__link:hover .round-collection-list__image-wrapper {
    transform: translateY(-4px);
    box-shadow:
      0 14px 30px rgb(var(--color-foreground-rgb) / var(--opacity-20)),
      0 5px 10px rgb(var(--color-foreground-rgb) / var(--opacity-15));
  }

  .round-collection-list__link[aria-current='page'] .round-collection-list__image-wrapper {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .round-collection-list__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .round-collection-list__title {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--font-size--sm);
    line-height: 1.3;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .round-collection-list__current-heading {
    margin-block-start: var(--padding-5xl);
    padding-block: var(--padding-lg);
    text-align: center;
  }

  .round-collection-list__current-title {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .round-collection-list__ornament {
    margin-block-start: var(--padding-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .round-collection-list__image-wrapper {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .round-collection-list {
      --round-collection-size: min(88px, var(--round-collection-size));
    }

    .round-collection-list__nav {
      margin-inline: calc(-1 * var(--page-margin));
    }

    .round-collection-list__items {
      padding-inline: var(--page-margin);
      scroll-padding-inline: var(--page-margin);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_list",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:content.heading",
      "default": "t:html_defaults.shop_by_collection"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list",
      "limit": 16
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "t:settings.width",
      "min": 72,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.color",
      "default": "#c9584c"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_list",
      "category": "t:categories.collections"
    }
  ]
}
{% endschema %}

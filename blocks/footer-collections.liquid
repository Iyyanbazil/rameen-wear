{% doc %}
  Renders a footer list of merchant-selected collections, falling back to all collections.

  @example
  {% content_for 'block', type: 'footer-collections', id: 'footer-collections' %}
{% enddoc %}

{% liquid
  assign footer_collections = block.settings.collection_list
  assign nav_label = block.settings.heading

  if footer_collections == blank
    assign footer_collections = collections
  endif

  if nav_label == blank
    assign nav_label = 'accessibility.link_to_collections' | t
  endif
%}

<div class="footer-collections" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="footer-collections__heading h5">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <nav aria-label="{{ nav_label | escape }}">
    <ul class="footer-collections__list list-unstyled" role="list">
      {% for collection_item in footer_collections limit: block.settings.max_collections %}
        <li class="footer-collections__item paragraph">
          <a href="{{ collection_item.url }}">{{ collection_item.title | escape }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</div>

{% stylesheet %}
  .footer-collections {
    width: 100%;
  }

  .footer-collections__heading {
    margin: 0 0 var(--padding-sm);
  }

  .footer-collections__list {
    margin: 0;
    padding: 0;
  }

  .footer-collections__item + .footer-collections__item {
    margin-block-start: var(--padding-xs);
  }

  .footer-collections__item a {
    color: inherit;
    text-decoration: none;
  }

  .footer-collections__item a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_list",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list",
      "limit": 12
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}

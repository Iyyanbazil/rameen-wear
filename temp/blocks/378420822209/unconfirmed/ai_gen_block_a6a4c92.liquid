{% doc %}
  @prompt
    create heading in the center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-centered-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    text-align: center;
    color: {{ block.settings.text_color }};
    padding-block: {{ block.settings.vertical_padding }}px;
  }

  .ai-centered-heading-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    text-transform: {{ block.settings.text_case }};
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 749px) {
    .ai-centered-heading-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div class="ai-centered-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <{{ block.settings.heading_level }} class="ai-centered-heading-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</{{ block.settings.heading_level }}>
</div>

{% schema %}
{
  "name": "Centered heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your heading"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "montserrat_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Centered heading"
    }
  ],
  "tag": null,
  "class": "centered-heading-block"
}
{% endschema %}